# 1) Version Ubuntu paramétrable
ARG UBUNTU_VERSION=25.10
FROM ubuntu:${UBUNTU_VERSION}

# 2) Variables utiles (optionnel mais pratique)
ENV DEBIAN_FRONTEND=noninteractive \
    NGINX_LISTEN_PORT=80

# 3) Installer nginx + curl (curl sert au HEALTHCHECK)
#    - nettoyage des caches apt pour une image plus légère
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 4) Créer le répertoire demandé AVANT de déclarer le volume
RUN mkdir -p /backup-content/

# 5) Déclarer le volume
VOLUME ["/backup-content"]

# 6) Définir le répertoire de travail demandé
WORKDIR /var/www

# 7) (Optionnel) Ajouter une page de test simple
#    Tu peux aussi COPY ton site ici si besoin
RUN echo "<h1>Nginx OK - Ubuntu ${UBUNTU_VERSION}</h1>" > /var/www/html/index.html

# 8) Configuration nginx minimale :
#    - on sert /var/www/html
#    - on écoute sur le port 80
#    - on envoie les logs vers stdout/stderr (utile en conteneur)
RUN printf '%s\n' \
'server {' \
'  listen 80 default_server;' \
'  listen [::]:80 default_server;' \
'  root /var/www/html;' \
'  index index.html;' \
'  location / {' \
'    try_files $uri $uri/ =404;' \
'  }' \
'  access_log /dev/stdout;' \
'  error_log  /dev/stderr;' \
'}' \
> /etc/nginx/sites-available/default

# 9) Exposer le port 80
EXPOSE 80

# 10) Healthcheck : vérifie que Nginx répond localement
#     curl -f échoue si code HTTP >= 400
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://localhost:${NGINX_LISTEN_PORT}/ || exit 1

# 11) Lancer nginx en foreground (requis pour Docker)
CMD ["nginx", "-g", "daemon off;"]